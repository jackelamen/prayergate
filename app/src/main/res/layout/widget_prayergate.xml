<?xml version="1.0" encoding="utf-8"?>
<!--
    The home-screen widget (see ui/PrayerGateWidget.kt).
    Left: the streak. Right: today's prayer. Paper, ink and rubric red,
    matching the app's prayer page.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:minWidth="64dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ebgaramond"
            android:includeFontPadding="false"
            android:textColor="#FF1F1A14"
            android:textSize="46sp" />

        <TextView
            android:id="@+id/widget_streak_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ebgaramond"
            android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:textColor="#FFA0231C"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- A thin divider. Widgets only allow certain view types, so it is a FrameLayout, not a View. -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="#55A0231C" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="9dp"
                android:layout_height="13dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_cross" />

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:fontFamily="@font/ebgaramond"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="#FFA0231C"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_prayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/ebgaramond"
            android:maxLines="4"
            android:textColor="#FF1F1A14"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/widget_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/ebgaramond"
            android:textColor="#FF6A5F52"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
