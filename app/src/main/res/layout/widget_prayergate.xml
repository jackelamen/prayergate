<?xml version="1.0" encoding="utf-8"?>
<!--
    The home-screen widget (see ui/PrayerGateWidget.kt).
    Left: the streak. Right: today's question. Lapis background, white text,
    and the citron full stop, matching the app's question screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:minWidth="64dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ebgaramond"
            android:includeFontPadding="false"
            android:textColor="#FFFFFFFF"
            android:textSize="46sp" />

        <TextView
            android:id="@+id/widget_streak_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/instrument_sans"
            android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:textColor="#BFFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- A thin divider. Widgets only allow certain view types, so it is a FrameLayout, not a View. -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="#33FFFFFF" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:fontFamily="@font/instrument_sans"
                android:letterSpacing="0.12"
                android:text="@string/widget_today"
                android:textAllCaps="true"
                android:textColor="#BFFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/ebgaramond"
            android:maxLines="3"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/instrument_sans"
            android:text="@string/widget_tap"
            android:textColor="#E4F45E"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
